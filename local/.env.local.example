# Copy this file to .env.local and replace placeholders before use.
# Confirm staging URLs, OAuth client ID, audience and issuer with the Gundi team.
# OlmoEarth base URL/token belong in the integration and Authenticate form,
# not in these runner environment variables; see ../examples/README.md.


# Edit this to have a secret from the stage environment (Ask the Gundi Team)
GUNDI_OAUTH_CLIENT_SECRET="REPLACE_WITH_GUNDI_OAUTH_CLIENT_SECRET"

LOG_LEVEL="DEBUG"
GUNDI_API_BASE_URL="https://api.stage.gundiservice.org"
GUNDI_OAUTH_AUDIENCE="cdip-admin-portal"
GUNDI_OAUTH_CLIENT_ID="cdip-integrations"
GUNDI_OAUTH_ISSUER="https://cdip-auth.pamdas.org/auth/realms/cdip-dev"
SENSORS_API_BASE_URL="https://sensors.api.stage.gundiservice.org"
REDIS_HOST="redis"
REDIS_PORT="6379"
# Gundi OAuth tokens are cached in Redis db 2 (REDIS_TOKEN_CACHE_DB) and shared by every client.


# These settings are for using a local pubsub emulator.
# It's recommended to leave these as-is. If you change values in this section, 
# you will likely have to change values in helper scripts too.
INTEGRATION_EVENTS_TOPIC="integration-events"
GCP_PROJECT_ID="local-project"
PUBSUB_EMULATOR_HOST=pubsub_emulator:8085
PUBSUB_PROJECT_ID=local-project
INTEGRATION_COMMANDS_TOPIC="local-actions-topic"
